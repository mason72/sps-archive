# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare R2
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=sps-prism
R2_PUBLIC_URL=https://your-bucket.r2.dev

# Modal (AI processing — DEFERRED. The app is fully usable without this.
# Smart Stacks, semantic search, and auto-sections will reactivate when
# the Modal pipeline ships in a future release.)
MODAL_API_URL=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Email (Resend — used for password reset + gallery emails)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Inngest (DEFERRED — only used by the AI pipeline. Leaving these
# empty is the correct default until AI ships.)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# SPS Integration (inter-service auth for SimplePhotoShare ↔ Archive)
SPS_INTEGRATION_KEY=your-shared-secret-key

# Gallery session signing — REQUIRED in production. Used to HMAC-sign
# password-gate and PIN cookies. Must be a random string ≥ 32 chars.
#   openssl rand -base64 48
GALLERY_SESSION_SECRET=

# Admin emails — comma-separated list of users allowed to call admin
# routes like /api/admin/batch-thumbnails and /api/admin/health.
# Empty/unset = deny.
ADMIN_EMAILS=

# Error monitoring (Sentry — optional). Logs/errors no-op without these.
# Server-side DSN (also used for edge runtime). Same value as NEXT_PUBLIC_SENTRY_DSN
# is fine, or use a separate project. NEXT_PUBLIC variant is required for browser SDK.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional: send a fraction of traces (0.1 = 10%). Default 0.1.
SENTRY_TRACES_SAMPLE_RATE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
# Optional: capture session replays on errors (0 disables; 1 = 100%).
NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=

# App URLs
NEXT_PUBLIC_APP_URL=https://app.pixeltrunk.com
NEXT_PUBLIC_MARKETING_URL=https://pixeltrunk.com

# Access control (comma-separated emails, empty = open registration)
ALLOWED_SIGNUP_EMAILS=info@twodudesphoto.com

# Stripe (subscription billing)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_SOLO_MONTHLY=price_xxx
STRIPE_PRICE_SOLO_ANNUAL=price_xxx
STRIPE_PRICE_PRO_MONTHLY=price_xxx
STRIPE_PRICE_PRO_ANNUAL=price_xxx
STRIPE_PRICE_STUDIO_MONTHLY=price_xxx
STRIPE_PRICE_STUDIO_ANNUAL=price_xxx
